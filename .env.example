# Encore Lot Browser — environment configuration example
# Copy this file to .env and fill in values as needed.
# .env is gitignored — never commit real tokens.

# HiBid JWT bearer token (optional — only needed if anon/cookie auth fails).
# How to get this token: see README.md § "Auth Troubleshooting".
# Paste the full eyJ... string copied from Chrome DevTools → Network → Authorization header.
HIBID_TOKEN=
