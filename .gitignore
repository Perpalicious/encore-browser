# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# Node / Viewer
node_modules/
dist/
.vite/
*.log

# Secrets / env
.env
.env.*
!.env.example

# Data
data/raw/
# Keep categorized README and provided sample; ignore future categorized uploads
data/categorized/*
!data/categorized/README.md
!data/categorized/auction_703264_categorized.json
# Prior weeks, moved out of the working folder (see "Data retention" in CLAUDE.md)
data/archive/
# Bid/watch history exports. The RAW history is a per-lot log of what this
# household bid on and watched — the repo is public and profile.yaml is written
# impersonally on purpose, so it stays local. The aggregate findings are
# tracked, because code comments and passes.yaml cite them.
data/Watch/*
!data/Watch/FINDINGS.md

# Note: viewer/src/data/auction_bundle.json IS committed — GitHub Pages
# deploys static bundles, so the data file ships in the repo. Regenerate
# it weekly via `python -m build` and commit the result.

# Playwright
test-results/
playwright-report/
playwright/.cache/

# OS
.DS_Store
Thumbs.db

# Claude
# .claude/ is machine-local, except the committed worker definition that
# `python -m classify` dispatches and fingerprints. Git does not descend
# into an excluded directory, so each parent level is re-included in turn.
.claude/*
!.claude/agents/
.claude/agents/*
!.claude/agents/lot-classifier.md
